# Copy this file to ".env" and fill in real values.
# .env must NEVER be committed.

# ---------- Bybit ----------
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# ---------- DEX RPC / WS endpoints ----------
# BSC
BSC_WS=wss://bsc.publicnode.com
BSC_RPC=https://bsc-dataseed.binance.org

# Ethereum
ETH_WS=wss://ethereum.publicnode.com
ETH_RPC=https://ethereum.publicnode.com

# Base
BASE_WS=wss://base.publicnode.com
BASE_RPC=https://mainnet.base.org

# ---------- Spread runner ----------
SPREAD_INTERVAL=5.0
SPREAD_MIN_PCT=1.0

# DEX WS stall watchdog: reconnect a chain subscription that delivered
# no events for this many seconds. Free/balanced endpoints (publicnode)
# sometimes kill the subscription while keeping the socket alive — the
# feed then silently goes empty forever without this. 0 = off.
WS_STALL_RECONNECT_SEC=300

# Staleness gates: skip a price older than this many seconds. 0 = off
# (default). Enable with care — illiquid tokens legitimately go quiet
# for long stretches. CEX gate is the safer one to try first; keep any
# DEX gate generous (hours, not minutes).
MAX_CEX_AGE_SEC=0
MAX_DEX_AGE_SEC=0

# ---------- Diagnostics ----------
# Seconds between full price_store snapshot dumps (0 = off)
PRICE_STORE_DUMP_INTERVAL=300

# ---------- Pool maintenance ----------
# Seconds between stale-pool validation passes (default: once per day)
POOL_REFRESH_INTERVAL=86400

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5

# ---------- Misc ----------
DEXSCREENER_CONCURRENCY=4

# Client-side rate cap (req/min) for GeckoTerminal + CoinGecko (shared
# bucket). GT free-tier 429s the pools endpoint below its nominal limit
# and each token can page up to 5 requests, so keep this low. 8/min is a
# safe default; lower it if you still see many "GT 429" warnings.
GECKO_RATE_PER_MIN=8

# Skip a (chain, symbol) pair for this many seconds after DexScreener
# returned no pool. Lower = faster pickup of new listings (more API
# usage). Higher = less load. Default 600 (10 min).
NO_POOL_RETRY_TTL_SEC=1200

# ---------- CoinGecko ----------
# How often to refresh the bulk platform list + Kraken tickers cache.
# 24h is plenty; 0 disables HTTP refresh (use existing cache only).
COINGECKO_REFRESH_INTERVAL=86400

# Optional Pro-tier API key. Empty = free public access (rate-limited
# to ~8 req/min). Pro gives much higher limits and snappier startup.
COINGECKO_API_KEY=

# ---------- Liquidity filter ----------
# Tokens whose aggregated DEX liquidity (sum across all pools on a chain
# from GeckoTerminal) is below this USD threshold get blacklisted from
# the spread runner — no point alerting on something that can't trade.
# 5000 is conservative; raise (e.g. 10000) to be stricter, lower (e.g.
# 2000) to keep more small-caps in scope.
LIQUIDITY_MIN_USD=5000

# Sum of 24h volume across all pools must clear this. Catches honeypot
# tokens with high "liquidity" but zero actual trading.
LIQUIDITY_MIN_VOL_USD=1000

# Per-bound-pool floor — even if aggregate above passes, the SPECIFIC
# pool we subscribe to must individually clear this. Catches tokens
# where many dust pools sum to "ok" but the actual bound pool is too
# small to price reliably (its swaps are too rare → DEX price freezes
# → phantom spread vs live CEX). $5000 is conservative.
BOUND_POOL_MIN_USD=5000

# ---------- Pool auto-upgrade ----------
# Whenever the liquidity check runs, also compare the currently-bound
# DEX pool against GeckoTerminal's top-liquidity pool for the same
# token. If GT's pick is substantially better, swap pools.json in-place.
# This fixes the "DexScreener picked a dust pool while a real $50k pool
# exists on a less-indexed DEX" case.
POOL_AUTO_UPGRADE=true
# Ratio gate is TIERED (hardcoded in engine.liquidity_filter, not
# configurable via env):
#   current_liq < $10k  → need 2.0x liquidity to upgrade
#   current_liq ≥ $10k  → need 1.5x
#   current_liq ≥ $50k  → any improvement (best > current)
# In addition, best.vol_24h must be strictly > current.vol_24h.
# Replacement candidate must have >= this much 24h volume (don't swap
# to a high-liquidity but zero-volume pool).
POOL_UPGRADE_MIN_VOL=500
# Pool selection is activity-first: a candidate must out-trade the
# currently-bound pool by this ratio (24h volume) to trigger a swap.
# Stops a fat-but-frozen pool (stale price -> phantom spreads) from
# winning over a leaner, actively-traded one. 1.5 = 50% more volume.
POOL_UPGRADE_VOL_RATIO=1.5

# ---------- Orderbook depth filter ----------
# A spread is only kept if the CEX side holds at least this much
# cumulative USD volume between its top-of-book and the DEX price.
# Catches phantom spreads where the book is too thin to trade.
ORDERBOOK_MIN_DEPTH_USD=500
# How often the depth poller REST-refreshes the Kraken orderbook for
# tokens that currently have an active spread (Bybit depth is WS-live).
ORDERBOOK_DEPTH_POLL_INTERVAL=8
